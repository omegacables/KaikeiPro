# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API (OCR & AI仕訳)
GOOGLE_API_KEY=your-google-api-key

# Moneytree LINK (口座連携) — Moneytree開発者ポータルで取得
# 本番/Staging のURLは Moneytree LINK ドキュメント参照
MONEYTREE_AUTH_BASE_URL=https://your-moneytree-auth-base-url
MONEYTREE_API_BASE_URL=https://your-moneytree-api-base-url
MONEYTREE_CLIENT_ID=your-moneytree-client-id
MONEYTREE_CLIENT_SECRET=your-moneytree-client-secret
MONEYTREE_REDIRECT_URI=http://localhost:3000/api/moneytree/callback

# Resend (メール通知) — 未実装、将来用
# RESEND_API_KEY=your-resend-api-key

# LINE Messaging API — 未実装、将来用
# LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# LINE_CHANNEL_SECRET=your-line-channel-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
